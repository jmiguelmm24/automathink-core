# ─── Automathink Core · .env de UN cliente (nunca se sube a GitHub) ───
# Lo genera deploy/new-client.sh en /docker/clients/<cliente>/.env

# Panel
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=          # npm run hash-password -- "contraseña-larga"
SESSION_SECRET=               # 64 hex: openssl rand -hex 32
COOKIE_SECURE=true            # false en local
TRUST_PROXY=true              # detrás de Traefik

# Cliente
CLIENT_DIR=/app/client        # carpeta con business.yaml (montada como volumen)
DB_PATH=/app/data/core.sqlite
DOMAIN=cliente.automathink.io # subdominio que sirve Traefik con HTTPS
PUBLIC_BASE_URL=https://cliente.automathink.io

# IA (clave del CLIENTE si es "agente privado"; si no, la de Automathink con tope)
ANTHROPIC_API_KEY=
MONTHLY_TOKEN_CAP=5000000     # al pasarlo, todo va a Haiku

# SMS (Twilio, número del cliente con A2P 10DLC aprobado)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX

# Avisos al dueño
OWNER_PHONE=+1XXXXXXXXXX
NOTIFY_WEBHOOK_URL=           # opcional: Slack / Make / n8n / CRM

# Formularios → back-office (cabecera x-intake-token)
INTAKE_TOKEN=                 # openssl rand -hex 24
