{
  "id": "followup",
  "name": "AI Lead Follow-up",
  "product": { "deck_name": "Seguimiento de Leads (CRM)", "setup_usd": 697, "monthly_usd": 397 },
  "description": "Replies from leads that were contacted by a follow-up message; re-engages them and moves them to book.",
  "kind": "conversational",
  "tier": "facil",
  "tools": ["save_lead", "check_availability", "book_appointment", "handoff_to_human"],
  "route": { "keywords": ["interested", "more info", "price", "quote", "estimate", "cotiza", "precio", "información", "informacion"], "priority": 5 },
  "reacts_to": {
    "booking.cancelled": { "handler": "onBookingCancelled", "chain": "cancel_to_followup", "defaults": { "after_hours": 24 } },
    "lead.scored": { "handler": "onLeadScored", "chain": "hot_lead", "defaults": { "min_score": 8, "low_score_delay_hours": 24 } }
  }
}
